{
  "name": "printbooth",
  "private": true,
  "version": "0.1.0",
  "description": "PrintBooth MVP — Self-Service Printing Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "kiosk/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:kiosk": "npm run dev --workspace=kiosk/ui",
    "dev:kiosk:ui": "npm run dev --workspace=kiosk/ui",
    "ui:kiosk": "npm run dev --workspace=kiosk/ui",
    "dev:api": "npm run dev --workspace=services/api",
    "build": "npm run build:api && npm run build:web && npm run build:admin",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:kiosk": "npm run build --workspace=kiosk/ui",
    "build:kiosk:ui": "npm run build --workspace=kiosk/ui",
    "build:api": "npm run build --workspace=services/api",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3"
  }
}
