# ─────────────────────────────────────────────
# PrintBooth Environment Configuration Template
# ─────────────────────────────────────────────

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/printbooth?retryWrites=true&w=majority

# API Server Port
PORT=5000

# Redis Cache & Fast Processing URL
REDIS_URL=redis://127.0.0.1:6379

# ==============================================================================
# Domain & Public URL Configuration
# ==============================================================================
# Set to your live custom domain (e.g., https://printbooth.in) or custom host.
# When set, all QR codes, standees, and links will dynamically use this URL.
SITE_URL=http://localhost:5200
CLIENT_WEB_URL=http://localhost:5200
CLIENT_ADMIN_URL=http://localhost:5174
CLIENT_KIOSK_URL=http://localhost:5175

# Frontend Vite variables (read directly by apps/web and apps/admin)
VITE_SITE_URL=http://localhost:5200
VITE_CLIENT_WEB_URL=http://localhost:5200
VITE_CLIENT_ADMIN_URL=http://localhost:5174
VITE_API_URL=http://localhost:5000/api

# JWT Secret
JWT_SECRET=printbooth_secure_jwt_secret_key_2026

# Payment Gateways (Razorpay / UPI Express)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPIEXPRESS_API_KEY=
UPIEXPRESS_MERCHANT_ID=
UPIEXPRESS_WEBHOOK_URL=
